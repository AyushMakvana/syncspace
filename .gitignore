# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (strict exclusion of secrets)
.env
.env.local
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# media & large files
public/videos/
*.mp4

# additional generated output
/dist/
/.cache/

# Firebase service account credentials
*service-account*.json
*service_account*.json
*-firebase-adminsdk-*.json

# private certificates and keys
*.p12
*.pfx
*.key

# local editor settings may contain credentials
.vscode/settings.json
